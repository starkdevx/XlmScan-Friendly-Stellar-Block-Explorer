# Stellar RPC & Data Providers
# Primary: Alchemy Stellar RPC & Data API (https://www.alchemy.com/docs/reference/stellar-data-api-overview)
ALCHEMY_API_KEY= 

# Secondary / Fallback: QuickNode Stellar RPC & Horizon
QUICKNODE_MAINNET_RPC_URL=
QUICKNODE_MAINNET_HORIZON_URL=
QUICKNODE_TESTNET_RPC_URL=
QUICKNODE_TESTNET_HORIZON_URL=

# Database (MongoDB Atlas or local MongoDB)
# Leave empty to use in-memory cache fallback for local development
MONGODB_URI=

# AI Intent Parser (Structured Output — Groq + Gemini)
# If both are omitted, uses deterministic rule-based intent parser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
# Generative model on Groq for structured JSON intent extraction
GROQ_MODEL=llama-3.1-8b-instant
# Optional safety/prompt-injection classifier on Groq
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Routing strategy: weighted_round_robin (2 Groq : 1 Gemini) | round_robin | failover
AI_ROUTING_STRATEGY=weighted_round_robin

# App settings
DEFAULT_STELLAR_NETWORK=mainnet
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
